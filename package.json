{
  "name": "brington-group-hse-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-worker.mjs && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "build:vercel": "vite build --mode vercel && node scripts/check-build.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@openai/sites-vite-plugin": "^0.1.0",
    "@playwright/test": "^1.63.0",
    "jsdom": "^26.0.0",
    "sharp": "^0.35.4",
    "vite": "8.3.0"
  },
  "dependencies": {
    "lucide": "^1.46.0"
  }
}
